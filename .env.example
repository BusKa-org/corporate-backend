# -------------------------------------------------------
# BusKá Backend Environment Variables
# Copy this file to `.env` and adjust values as needed
# -------------------------------------------------------

# Flask
FLASK_ENV=development
FLASK_DEBUG=true

# -------------------------
# Database configuration
# -------------------------
# Used by Flask, Alembic and scripts

DB_HOST=localhost
DB_PORT=5433
DB_USER=buska_user
DB_PASSWORD=buska_pass
DB_NAME=buska_db

# -------------------------
# API configuration
# -------------------------

API_PORT=5000

# JWT
JWT_SECRET_KEY=change-this-secret-key
JWT_EXPIRES_HOURS=2

# -------------------------
# CORS configuration
# -------------------------
# Comma-separated list of allowed origins
# Leave empty in development to allow all origins
# Example:
# CORS_ORIGINS=https://app.buska.com,https://admin.buska.com

CORS_ORIGINS=

# -------------------------
# Rate limit (Flask-Limiter)
# -------------------------
# Onde ficam os contadores. Redis deixa um contador só para todos os workers do
# gunicorn; memory:// conta separado em cada worker e é recusado em produção.
# `make run` / `make db-up` sobem o Redis local na porta 6380.
RATELIMIT_STORAGE_URI=redis://localhost:6380/0
RATELIMIT_ENABLED=true
# Formato: "<n> per <second|minute|hour|day>"
RATELIMIT_DEFAULT=2000 per hour
RATELIMIT_AUTH=10 per minute
RATELIMIT_SENSITIVE=5 per minute
# GPS, telemetria e embarque (muitas requisições seguidas do mesmo usuário)
RATELIMIT_REALTIME=120 per minute

# -------------------------
# Viagens sob demanda
# -------------------------
# Fuso da organização (IANA): janelas de disponibilidade e jornada do motorista
TIMEZONE=America/Sao_Paulo
# Buffer e prazo de início das rotas sob demanda, em minutos.
# PADRAO vale quando o gestor cria a rota sem informar; MAX é o limite aceito.
# Baixar um MAX abaixo do PADRAO exige definir o PADRAO também (senão a API não sobe em produção).
ROTA_BUFFER_MINUTOS_PADRAO=5
ROTA_BUFFER_MINUTOS_MAX=30
ROTA_PRAZO_INICIO_MINUTOS_PADRAO=10
ROTA_PRAZO_INICIO_MINUTOS_MAX=120
# Intervalo dos jobs: fechar buffer expirado / avisar gestor do prazo de início
JOB_BUFFER_INTERVALO_SEGUNDOS=30
JOB_PRAZO_INICIO_INTERVALO_SEGUNDOS=60

# Jornada do motorista
# -------------------------
# Padrão: CTB art. 67-C §1º-A (Lei 13.103/2015), 30 min de descanso a cada 4 h de direção
MOTORISTA_HORAS_MAX_DIRECAO=4
MOTORISTA_DESCANSO_MINUTOS=30

# -------------------------
# Fotos dos alunos
# -------------------------
# Pasta onde as fotos ficam. Vazio = instance/fotos_aluno
FOTOS_ALUNO_DIR=
# Tamanho máximo da foto, em bytes (padrão 5 MB)
FOTO_ALUNO_MAX_BYTES=5242880
# Máximo de pixels (largura x altura) da foto (padrão 25 milhões = 25 MP)
FOTO_ALUNO_MAX_PIXELS=25000000

# -------------------------
# Embarque por QR e fila offline
# -------------------------
# Código TOTP do QR: muda a cada QR_PASSO_SEGUNDOS, com QR_DIGITOS dígitos;
# aceita até QR_JANELA_PASSOS passos de diferença do relógio do servidor
QR_PASSO_SEGUNDOS=30
QR_DIGITOS=6
QR_JANELA_PASSOS=1
# Quanto o relógio do app do motorista pode estar adiantado na sincronização
SYNC_TOLERANCIA_SEGUNDOS=120

# -------------------------
# E-mail, links e push (opcionais)
# -------------------------
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
# Links nos e-mails de consentimento e convite
FRONTEND_URL=http://localhost:8081
APP_DOWNLOAD_URL=
# JSON da conta de serviço do Firebase; vazio = usa firebase-credentials.json se existir
FIREBASE_CREDENTIALS=
