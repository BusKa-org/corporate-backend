# -------------------------------------------------------
# BusKá Backend Environment Variables
# Copy this file to `.env` and adjust values as needed
# -------------------------------------------------------

# Flask
FLASK_ENV=development
FLASK_DEBUG=true

# -------------------------
# Database configuration
# -------------------------
# Used by Flask, Alembic and scripts

DB_HOST=localhost
DB_PORT=5433
DB_USER=buska_user
DB_PASSWORD=buska_pass
DB_NAME=buska_db

# -------------------------
# API configuration
# -------------------------

API_PORT=5000

# JWT
JWT_SECRET_KEY=change-this-secret-key
JWT_EXPIRES_HOURS=2

# -------------------------
# CORS configuration
# -------------------------
# Comma-separated list of allowed origins
# Leave empty in development to allow all origins
# Example:
# CORS_ORIGINS=https://app.buska.com,https://admin.buska.com

CORS_ORIGINS=
